rules_version = '2';

// GIMPA Resource Manager Firestore rules.
//
// The client app trusts the user doc for role/approval state, so these
// rules must enforce the SAME shape the UI gates on:
//   - users/{uid}.role           : string
//   - users/{uid}.approved       : bool
//   - users/{uid}.department     : string | null
//
// All collection-scoped helpers below read the requester's user doc.
// Role lists live in src/app/lib/roles.js — keep the inline arrays in
// isAdmin / isGlobalApprover / isMaintenanceStaff in sync with that
// file by hand (rules can't import JS).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return userExists() ? userDoc().role : null;
    }

    function isApproved() {
      return userExists() && userDoc().approved == true;
    }

    // Mirrors PLATFORM_ADMINS in src/app/lib/roles.js.
    function isAdmin() {
      return myRole() in [
        "super_admin",
        "Secretariat Admin",
        "IT Officer"
      ];
    }

    function isOperationalApprover() {
      return myRole() in [
        "Facility/Estate Officer",
        "Stores/Inventory Officer",
        "Receptionist"
      ];
    }

    // Mirrors GLOBAL_APPROVERS in src/app/lib/roles.js. super_admin
    // is intentionally omitted — they already pass via isAdmin().
    function isGlobalApprover() {
      return myRole() in [
        "Administrative Officer",
        "Higher Level Management"
      ];
    }

    // Mirrors MAINTENANCE_ROLES in src/app/lib/roles.js. Maintenance
    // Staff can flip lifecycleStatus + condition on resources and write
    // entries into the resource history subcollections; they are NOT
    // admins or global approvers and don't see all bookings.
    // Stage 4e.5: Maintenance Admin joins the maintenance domain too,
    // so this list is the visibility/membership predicate. The narrower
    // tier predicate is isMaintenanceAdmin() below.
    function isMaintenanceStaff() {
      return myRole() in [
        "super_admin",
        "Maintenance Admin",
        "Maintenance Staff"
      ];
    }

    // Mirrors MAINTENANCE_ADMINS in src/app/lib/roles.js. The
    // department-head tier: assigns faults, overrides workflow gates,
    // and oversees all maintenance activity. super_admin counts too.
    function isMaintenanceAdmin() {
      return myRole() in [
        "super_admin",
        "Maintenance Admin"
      ];
    }

    function cannotBook() {
      return myRole() == "General Student";
    }

    // ---------------------------------------------------------------
    // Stage 4e.7: Resource responsibility partitioning
    // ---------------------------------------------------------------
    // myCategories() — categories the current user manages, derived
    // from role. Mirrors ROLE_TO_CATEGORIES in
    // src/app/lib/categoryResponsibility.js. Rules can't import JS, so
    // keep this in sync by hand.
    function myCategories() {
      return myRole() == "Facility/Estate Officer"
        ? ["Facilities", "Furniture"]
      : myRole() == "IT Officer"
        ? ["Electronics & Electrical Equipment"]
      : myRole() == "Logistics Officer"
        ? ["Vehicles & Transport"]
      : myRole() == "Stores/Inventory Officer"
        ? ["Office Supplies & Stationery",
           "Tools & Maintenance Equipment",
           "Other"]
      : [];
    }

    function canManageCategory(category) {
      return category in myCategories();
    }

    // Mirrors RESOURCE_MANAGERS in src/app/lib/roles.js. Anyone in
    // this list manages a category slice; super_admin is handled
    // separately via isAdmin().
    function isResourceManager() {
      return myRole() in [
        "Facility/Estate Officer",
        "IT Officer",
        "Logistics Officer",
        "Stores/Inventory Officer"
      ];
    }

    // ---------------------------------------------------------------
    // users/{uid}
    //
    // Anyone signed in can create their own doc at signup. After that,
    // only the user themselves or an admin can read/update it. No one
    // can promote themselves to a privileged role.
    // ---------------------------------------------------------------
    match /users/{uid} {

      // Single-doc reads stay strict — only the user themselves or an
      // admin. Listing/querying users is allowed for the operator
      // roles that drive the custodian picker on AddResourceForm
      // (stores/facility) plus Maintenance Staff (Stage 4c+).
      allow get: if isSignedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow list: if isApproved() && (
        isAdmin()
        || isOperationalApprover()
        || isMaintenanceStaff()
        // Stage 4h: resource managers need the staff list to drive the
        // TransferAssetModal custodian picker. Logistics Officer is
        // the only RM not already covered by the lists above.
        || isResourceManager()
      );

      // Self-create at signup. We can't read the user doc here (it
      // doesn't exist yet), so we trust the email-derived defaults
      // and reject anyone trying to seed themselves as approved+admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && !(request.resource.data.role in [
          "super_admin",
          "Secretariat Admin",
          "IT Officer"
        ] && request.resource.data.approved == true);

      // Self-update: user can edit profile fields but cannot change
      // their own role or approval state.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.approved == resource.data.approved)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // resources/{assetCode}
    //
    // Any approved user can list resources to book them. Admins and
    // the dedicated stores/facility officers can create/delete and
    // make any edit. Maintenance Staff (Stage 4a+) can update ONLY
    // {lifecycleStatus, condition} — the affectedKeys().hasOnly([...])
    // guard is what stops them from touching name, custodian, cost,
    // location, vendor, etc.
    // ---------------------------------------------------------------
    match /resources/{assetCode} {

      allow read: if isApproved();

      // Stage 4e.7: only platform admins (super_admin / Secretariat /
      // IT Officer-as-admin) OR a resource manager creating within
      // their own category may add a resource. The responsibleRole
      // field must match the requester's role so a manager can't
      // mislabel a resource as belonging to a different team.
      allow create: if isApproved() && (
        isAdmin()
        || (
          isResourceManager()
          && canManageCategory(request.resource.data.category)
          && request.resource.data.responsibleRole == myRole()
        )
      );

      // Update: platform admins go through; resource managers can
      // edit ONLY resources in their own categories; Maintenance Staff
      // (Stage 4a) retain the narrow lifecycleStatus/condition patch.
      // Stage 4f: "updatedAt" is now allowed in the maintenance patch
      // because updateFaultStatus writes it alongside condition when
      // resolving a fault. isMaintenanceStaff() already covers super_
      // admin + Maintenance Admin + Maintenance Staff, so the resolve
      // path works for all three tiers.
      allow update: if isApproved() && (
        isAdmin()
        || (
          isResourceManager()
          && canManageCategory(resource.data.category)
        )
        || (
          isMaintenanceStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["lifecycleStatus", "condition", "updatedAt"])
        )
      );

      // Delete: platform admins OR the responsible resource manager.
      allow delete: if isApproved() && (
        isAdmin()
        || (
          isResourceManager()
          && canManageCategory(resource.data.category)
        )
      );
    }

    // ---------------------------------------------------------------
    // resources/{assetCode}/{conditionHistory|lifecycleHistory|
    //                       custodianHistory}/{entryId}
    //
    // Immutable per-asset audit log. One match block per subcollection
    // (rules can't parameterize on the collection name).
    //
    // Read:    any approved user — matches the parent /resources
    //          read rule (everyone who can see the resource can see
    //          its history).
    // Create:  admin, Maintenance Staff, or operational approvers.
    //          Operational approvers need create access because they
    //          write the initial history entries on resource creation
    //          (AddResourceForm).
    // Update/
    // Delete:  denied — history is append-only.
    //
    // TODO(stage-4c): lock down field shape on create
    // (changedAt, oldX/newX, reason, changedBy{uid,name,role}) once
    // the Maintenance UI starts writing these from clients. For 4a
    // payloads are unconstrained because only trusted code (the seed
    // script + AddResourceForm) writes them.
    // ---------------------------------------------------------------
    match /resources/{assetCode}/conditionHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin()
        || isMaintenanceStaff()
        || isOperationalApprover()
        || isResourceManager()
      );
      allow update, delete: if false;
    }

    match /resources/{assetCode}/lifecycleHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin()
        || isMaintenanceStaff()
        || isOperationalApprover()
        || isResourceManager()
      );
      allow update, delete: if false;
    }

    match /resources/{assetCode}/custodianHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin()
        || isMaintenanceStaff()
        || isOperationalApprover()
        || isResourceManager()
      );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // resources/{assetCode}/transfers/{transferId}  (Stage 4h)
    //
    // First-class transfer events — custodian and/or location moves
    // with reason + actor. Distinct from custodianHistory above, which
    // only captures initial-registration provenance from seedResources.
    //
    // Read:    any approved user (matches parent /resources read).
    // Create:  platform admin OR responsible resource manager
    //          (whose role matches the parent resource's
    //          responsibleRole). Payload validations:
    //          - reason is non-empty string with 10 ≤ len ≤ 500
    //          - transferredBy.uid matches auth uid
    //          - at least one of {custodianChanged, locationChanged} is true
    // Update/
    // Delete:  denied — transfers are immutable audit entries.
    //
    // Separation-of-duties (current custodian cannot transfer their
    // own asset) is enforced client-side in transferAsset.js — the
    // rule layer would need an extra get() and the SoD check is also
    // visible in the UI (button hidden), so the duplication isn't
    // worth the extra read here.
    // ---------------------------------------------------------------
    match /resources/{assetCode}/transfers/{transferId} {

      function parentResourceForTransfer() {
        return get(/databases/$(database)/documents/resources/$(assetCode)).data;
      }

      allow read: if isApproved();

      allow create: if isApproved()
        && (
          isAdmin()
          || (
            isResourceManager()
            && parentResourceForTransfer().responsibleRole == myRole()
          )
        )
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.transferredBy.uid == request.auth.uid
        && (
          request.resource.data.custodianChanged == true
          || request.resource.data.locationChanged == true
        );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // bookings/{bookingId}
    //
    // Create:  approved user who is allowed to book, requesterId must
    //          match auth uid, status must be "pending".
    // Read:    requester, anyone whose role is in visibleToRoles, or
    //          an admin / global approver.
    // Update:  TWO independent branches —
    //   (a) approve/reject: admin / global approver / anyone in
    //       visibleToRoles can flip status pending → approved|rejected.
    //   (b) chat metadata: anyone with parent-booking visibility can
    //       update ONLY {lastMessageAt, lastMessageAuthorId,
    //       lastReadByUser}. Enforced via diff().affectedKeys()
    //       .hasOnly(...). Used by sendBookingMessage (stamps latest-
    //       message metadata) and BookingChat (read-receipt).
    //
    //       Note: this branch doesn't constrain WHICH key of the
    //       lastReadByUser map gets written — a malicious user could
    //       suppress unread for another user by writing their uid.
    //       Acceptable for the institutional threat model; harden
    //       later if needed.
    // Delete:  admin only.
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {

      function canSeeBooking() {
        return resource.data.requesterId == request.auth.uid
          || myRole() in resource.data.visibleToRoles
          || (resource.data.approvalRoutedTo is list
              && myRole() in resource.data.approvalRoutedTo)
          || isAdmin()
          || isGlobalApprover();
      }

      function isChatMetadataOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessageAt",
            "lastMessageAuthorId",
            "lastReadByUser"
          ]);
      }

      allow create: if isApproved()
        && !cannotBook()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if isApproved() && (
        resource.data.requesterId == request.auth.uid
        || myRole() in resource.data.visibleToRoles
        || (resource.data.approvalRoutedTo is list
            && myRole() in resource.data.approvalRoutedTo)
        || isAdmin()
        || isGlobalApprover()
        // Stage 4j: institutional reporting (AnalyticsResourceManager)
        // needs broad read so role-scoped collection listeners work.
        // The view filters to "my responsibility" client-side; rules
        // engine can't prove the array-contains query is safe.
        || isResourceManager()
      );

      // Stage 4e.7: approve/reject now gates on approvalRoutedTo,
      // the partitioned routing list. Platform admins keep override
      // access. The legacy visibleToRoles check is kept inline so
      // pre-4e.7 bookings with no approvalRoutedTo still work.
      allow update: if isApproved() && (
        (
          (
            isAdmin()
            || (resource.data.approvalRoutedTo is list
                && myRole() in resource.data.approvalRoutedTo)
            || myRole() in resource.data.visibleToRoles
          )
          && request.resource.data.status in ["approved", "rejected"]
          && resource.data.status == "pending"
        )
        || (
          canSeeBooking()
          && isChatMetadataOnlyUpdate()
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // bookings/{bookingId}/messages/{messageId}
    //
    // Per-booking chat threads. Same visibility model as the parent
    // booking: requester, anyone whose role is in visibleToRoles, or
    // an admin / global approver.
    //
    // Read:    matches parent booking visibility.
    // Create:  matches parent visibility AND authorId == auth.uid AND
    //          text is a non-empty string ≤ 1000 chars. Kept in sync
    //          with MAX_MESSAGE_LENGTH in sendBookingMessage.js.
    // Update/
    // Delete:  denied — messages are immutable.
    //
    // The bookingDoc() helper does one extra get() per rule evaluation
    // (parent doc lookup); this is unavoidable for cross-doc auth and
    // is the same shape the parent rule uses on its own resource.data.
    // ---------------------------------------------------------------
    match /bookings/{bookingId}/messages/{messageId} {

      function bookingDoc() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      function canSeeParentBooking() {
        return bookingDoc().requesterId == request.auth.uid
          || myRole() in bookingDoc().visibleToRoles
          || isAdmin()
          || isGlobalApprover();
      }

      allow read: if isApproved() && canSeeParentBooking();

      allow create: if isApproved()
        && canSeeParentBooking()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // faults/{faultId}  (Stage 4d)
    //
    // Create:  any approved user. reporterId must match auth uid;
    //          status must be "pending"; description must be non-empty
    //          and ≤ 2000 chars. (Severity / image / routing are
    //          validated client-side; Storage rules also gate image
    //          size + content type.)
    // Read:    reporter, anyone whose role is in routedToRoles, admin,
    //          or Maintenance Staff.
    // Update:  admin + Maintenance Staff only (Stage 4e workflow
    //          transitions will use this). Reporters cannot edit
    //          their own faults — the model is "report and forget";
    //          ownership transfers to maintenance on submit.
    // Delete:  admin only.
    // ---------------------------------------------------------------
    match /faults/{faultId} {

      function canSeeFault() {
        return resource.data.reporterId == request.auth.uid
          || myRole() in resource.data.routedToRoles
          || isAdmin()
          || isMaintenanceStaff()
          // Stage 4j: AnalyticsPlatform / AnalyticsResourceManager
          // need broad read for cross-collection reporting.
          || isGlobalApprover()
          || isResourceManager();
      }

      // Mirrors the bookings chat-metadata pattern (see bookings rule
      // above). Lets sendFaultMessage's writeBatch stamp lastMessageAt
      // etc. without granting full update access to non-maintenance
      // viewers.
      function isFaultChatMetadataOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessageAt",
            "lastMessageAuthorId",
            "lastReadByUser"
          ]);
      }

      allow read: if isApproved() && canSeeFault();

      allow create: if isApproved()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.resourceId is string
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000;

      // TWO branches:
      //   (a) workflow transitions — admin / Maintenance Staff can do
      //       arbitrary updates (status flips, resolutionNotes, etc.).
      //       Stage 4e.
      //   (b) chat metadata — anyone with parent-fault visibility can
      //       update ONLY {lastMessageAt, lastMessageAuthorId,
      //       lastReadByUser} so reporters can send chat messages
      //       without being granted full update access.
      allow update: if isApproved() && (
        (isAdmin() || isMaintenanceAdmin() || isMaintenanceStaff())
        || (
          canSeeFault()
          && isFaultChatMetadataOnlyUpdate()
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // faults/{faultId}/assignmentHistory/{entryId}  (Stage 4e.5)
    //
    // Append-only audit log of assignment changes (assign / reassign /
    // release). Mirrors the parent fault's visibility for reads. Only
    // admins, Maintenance Admin, or Maintenance Staff can append (the
    // reporter never writes here).
    //
    // Read:    inherits parent visibility (reporter sees who owns
    //          their fault). One extra get() per evaluation.
    // Create:  admin, Maintenance Admin, or Maintenance Staff.
    //          Field shape is enforced by assignFault.js client-side;
    //          rules deliberately don't lock down the payload yet to
    //          match the looser stance on statusHistory.
    // Update/
    // Delete:  denied — history is append-only.
    // ---------------------------------------------------------------
    match /faults/{faultId}/assignmentHistory/{entryId} {

      function parentFaultAssign() {
        return get(/databases/$(database)/documents/faults/$(faultId)).data;
      }

      function canSeeParentFaultAssign() {
        return parentFaultAssign().reporterId == request.auth.uid
          || myRole() in parentFaultAssign().routedToRoles
          || isAdmin()
          || isMaintenanceAdmin()
          || isMaintenanceStaff()
          // Stage 4j: mirror the parent /faults visibility broadening.
          || isGlobalApprover()
          || isResourceManager();
      }

      allow read: if isApproved() && canSeeParentFaultAssign();

      allow create: if isApproved() && (
        isAdmin() || isMaintenanceAdmin() || isMaintenanceStaff()
      );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // faults/{faultId}/statusHistory/{entryId}  (Stage 4d)
    //
    // Append-only audit log mirroring the parent fault's visibility.
    // Stage 4d writes one entry on create (the "Fault reported" entry,
    // authored by the reporter — see the canCreateEntry helper). Stage
    // 4e adds entries on each workflow transition (acknowledged, in
    // progress, resolved), all of which run under admin/maintenance
    // accounts.
    //
    // Read:    inherits the parent fault's visibility via a get().
    // Create:  admin, Maintenance Staff, OR the reporter writing their
    //          own initial entry (changedBy.uid == auth.uid).
    // Update/
    // Delete:  denied.
    // ---------------------------------------------------------------
    match /faults/{faultId}/statusHistory/{entryId} {

      function parentFault() {
        return get(/databases/$(database)/documents/faults/$(faultId)).data;
      }

      function canSeeParentFault() {
        return parentFault().reporterId == request.auth.uid
          || myRole() in parentFault().routedToRoles
          || isAdmin()
          || isMaintenanceStaff()
          // Stage 4j: mirror the parent /faults visibility broadening.
          || isGlobalApprover()
          || isResourceManager();
      }

      allow read: if isApproved() && canSeeParentFault();

      allow create: if isApproved() && (
        isAdmin()
        || isMaintenanceStaff()
        || request.resource.data.changedBy.uid == request.auth.uid
      );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // supplyRequests/{requestId}  (Stage 4e.8)
    //
    // Maintenance staff/admin ask Stores for tools / consumables. Stores
    // (and super_admin) decide; the requester can cancel their own
    // pending request.
    //
    // Read:    requester, anyone in routedToRoles, admin, Maintenance
    //          Admin, or Maintenance Staff. Same broad-visibility model
    //          as faults so the maintenance domain can audit requests
    //          across the team.
    // Create:  maintenance domain (admin or staff) or platform admin.
    //          requesterId must match auth uid; status pinned to
    //          "pending"; reason must be non-empty <=1000; items must
    //          be a non-empty list.
    // Update:  TWO branches —
    //   (a) Stores (in routedToRoles) or platform admin can transition
    //       the workflow (approve/deny/fulfill).
    //   (b) Requester can flip their OWN pending request to "cancelled".
    // Delete:  admin only.
    // ---------------------------------------------------------------
    match /supplyRequests/{requestId} {

      function canSeeSupplyRequest() {
        return resource.data.requesterId == request.auth.uid
          || myRole() in resource.data.routedToRoles
          || isAdmin()
          || isMaintenanceAdmin()
          || isMaintenanceStaff()
          // Stage 4j: AnalyticsPlatform reporting needs broad read.
          || isGlobalApprover();
      }

      allow read: if isApproved() && canSeeSupplyRequest();

      allow create: if isApproved()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending"
        && (
          isMaintenanceAdmin()
          || isMaintenanceStaff()
          || isAdmin()
        )
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      allow update: if isApproved() && (
        isAdmin()
        || (
          myRole() == "Stores/Inventory Officer"
          && myRole() in resource.data.routedToRoles
        )
        || (
          resource.data.requesterId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "cancelled"
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // supplyRequests/{requestId}/statusHistory/{entryId}  (Stage 4e.8)
    //
    // Append-only audit log mirroring the parent request's visibility.
    // The requester writes the initial "Supply request submitted" entry
    // alongside the create — covered by the changedBy.uid == auth.uid
    // branch. Subsequent entries are written by Stores / admin /
    // maintenance during the workflow.
    // ---------------------------------------------------------------
    match /supplyRequests/{requestId}/statusHistory/{entryId} {

      function parentSupplyReq() {
        return get(/databases/$(database)/documents/supplyRequests/$(requestId)).data;
      }

      function canSeeParentSupplyReq() {
        return parentSupplyReq().requesterId == request.auth.uid
          || myRole() in parentSupplyReq().routedToRoles
          || isAdmin()
          || isMaintenanceAdmin()
          || isMaintenanceStaff()
          // Stage 4j: mirror the parent /supplyRequests visibility.
          || isGlobalApprover();
      }

      allow read: if isApproved() && canSeeParentSupplyReq();

      allow create: if isApproved() && (
        isAdmin()
        || isMaintenanceAdmin()
        || isMaintenanceStaff()
        || myRole() == "Stores/Inventory Officer"
        || request.resource.data.changedBy.uid == request.auth.uid
      );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // imports/{importId}  (Stage 4i)
    //
    // Audit log for bulk CSV resource imports — one doc per import
    // attempt, written by bulkImportResources after all batches commit
    // (or fail).
    //
    // Read:    platform admins only. Resource managers don't see the
    //          aggregated history (out of scope for 4i).
    // Create:  platform admins OR any resource manager. importedBy.uid
    //          must match the caller (so a malicious user can't forge
    //          an audit entry attributing the import to someone else).
    // Update/
    // Delete:  denied — audit entries are immutable.
    //
    // Payload shape is enforced client-side; rules deliberately stay
    // permissive on field constraints to match statusHistory's
    // approach. Tighten if forged-payload abuse shows up.
    // ---------------------------------------------------------------
    match /imports/{importId} {

      allow read: if isApproved() && isAdmin();

      allow create: if isApproved()
        && (isAdmin() || isResourceManager())
        && request.resource.data.importedBy.uid == request.auth.uid;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // faults/{faultId}/messages/{messageId}  (Stage 4e)
    //
    // Per-fault chat thread. Same visibility model as the parent fault:
    // reporter, anyone whose role is in routedToRoles, admin, or
    // Maintenance Staff.
    //
    // Read:    matches parent fault visibility (one extra get()).
    // Create:  matches parent visibility AND authorId == auth.uid AND
    //          text is a non-empty string ≤ 1000 chars. Kept in sync
    //          with MAX_MESSAGE_LENGTH in sendFaultMessage.js.
    // Update/
    // Delete:  denied — messages are immutable.
    // ---------------------------------------------------------------
    match /faults/{faultId}/messages/{messageId} {

      function parentFaultMsg() {
        return get(/databases/$(database)/documents/faults/$(faultId)).data;
      }

      function canSeeParentFaultMsg() {
        return parentFaultMsg().reporterId == request.auth.uid
          || myRole() in parentFaultMsg().routedToRoles
          || isAdmin()
          || isMaintenanceStaff();
      }

      allow read: if isApproved() && canSeeParentFaultMsg();

      allow create: if isApproved()
        && canSeeParentFaultMsg()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update, delete: if false;
    }
  }
}
