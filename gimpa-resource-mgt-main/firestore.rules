rules_version = '2';

// GIMPA Resource Manager Firestore rules.
//
// The client app trusts the user doc for role/approval state, so these
// rules must enforce the SAME shape the UI gates on:
//   - users/{uid}.role           : string
//   - users/{uid}.approved       : bool
//   - users/{uid}.department     : string | null
//
// All collection-scoped helpers below read the requester's user doc.
// Role lists live in src/app/lib/roles.js — keep the inline arrays in
// isAdmin / isGlobalApprover / isMaintenanceStaff in sync with that
// file by hand (rules can't import JS).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return userExists() ? userDoc().role : null;
    }

    function isApproved() {
      return userExists() && userDoc().approved == true;
    }

    // Mirrors PLATFORM_ADMINS in src/app/lib/roles.js.
    function isAdmin() {
      return myRole() in [
        "super_admin",
        "Secretariat Admin",
        "IT Officer"
      ];
    }

    function isOperationalApprover() {
      return myRole() in [
        "Facility/Estate Officer",
        "Stores/Inventory Officer",
        "Receptionist"
      ];
    }

    // Mirrors GLOBAL_APPROVERS in src/app/lib/roles.js. super_admin
    // is intentionally omitted — they already pass via isAdmin().
    function isGlobalApprover() {
      return myRole() in [
        "Administrative Officer",
        "Higher Level Management"
      ];
    }

    // Mirrors MAINTENANCE_ROLES in src/app/lib/roles.js. Maintenance
    // Staff can flip lifecycleStatus + condition on resources and write
    // entries into the resource history subcollections; they are NOT
    // admins or global approvers and don't see all bookings.
    function isMaintenanceStaff() {
      return myRole() in [
        "super_admin",
        "Maintenance Staff"
      ];
    }

    function cannotBook() {
      return myRole() == "General Student";
    }

    // ---------------------------------------------------------------
    // users/{uid}
    //
    // Anyone signed in can create their own doc at signup. After that,
    // only the user themselves or an admin can read/update it. No one
    // can promote themselves to a privileged role.
    // ---------------------------------------------------------------
    match /users/{uid} {

      // Single-doc reads stay strict — only the user themselves or an
      // admin. Listing/querying users is allowed for the operator
      // roles that drive the custodian picker on AddResourceForm
      // (stores/facility) plus Maintenance Staff (Stage 4c+).
      allow get: if isSignedIn() && (
        request.auth.uid == uid || isAdmin()
      );

      allow list: if isApproved() && (
        isAdmin()
        || isOperationalApprover()
        || isMaintenanceStaff()
      );

      // Self-create at signup. We can't read the user doc here (it
      // doesn't exist yet), so we trust the email-derived defaults
      // and reject anyone trying to seed themselves as approved+admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && !(request.resource.data.role in [
          "super_admin",
          "Secretariat Admin",
          "IT Officer"
        ] && request.resource.data.approved == true);

      // Self-update: user can edit profile fields but cannot change
      // their own role or approval state.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.approved == resource.data.approved)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // resources/{assetCode}
    //
    // Any approved user can list resources to book them. Admins and
    // the dedicated stores/facility officers can create/delete and
    // make any edit. Maintenance Staff (Stage 4a+) can update ONLY
    // {lifecycleStatus, condition} — the affectedKeys().hasOnly([...])
    // guard is what stops them from touching name, custodian, cost,
    // location, vendor, etc.
    // ---------------------------------------------------------------
    match /resources/{assetCode} {

      allow read: if isApproved();

      allow create: if isApproved() && (
        isAdmin() || isOperationalApprover()
      );

      allow update: if isApproved() && (
        isAdmin()
        || isOperationalApprover()
        || (
          isMaintenanceStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["lifecycleStatus", "condition"])
        )
      );

      allow delete: if isApproved() && (
        isAdmin() || isOperationalApprover()
      );
    }

    // ---------------------------------------------------------------
    // resources/{assetCode}/{conditionHistory|lifecycleHistory|
    //                       custodianHistory}/{entryId}
    //
    // Immutable per-asset audit log. One match block per subcollection
    // (rules can't parameterize on the collection name).
    //
    // Read:    any approved user — matches the parent /resources
    //          read rule (everyone who can see the resource can see
    //          its history).
    // Create:  admin, Maintenance Staff, or operational approvers.
    //          Operational approvers need create access because they
    //          write the initial history entries on resource creation
    //          (AddResourceForm).
    // Update/
    // Delete:  denied — history is append-only.
    //
    // TODO(stage-4c): lock down field shape on create
    // (changedAt, oldX/newX, reason, changedBy{uid,name,role}) once
    // the Maintenance UI starts writing these from clients. For 4a
    // payloads are unconstrained because only trusted code (the seed
    // script + AddResourceForm) writes them.
    // ---------------------------------------------------------------
    match /resources/{assetCode}/conditionHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin() || isMaintenanceStaff() || isOperationalApprover()
      );
      allow update, delete: if false;
    }

    match /resources/{assetCode}/lifecycleHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin() || isMaintenanceStaff() || isOperationalApprover()
      );
      allow update, delete: if false;
    }

    match /resources/{assetCode}/custodianHistory/{entryId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        isAdmin() || isMaintenanceStaff() || isOperationalApprover()
      );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // bookings/{bookingId}
    //
    // Create:  approved user who is allowed to book, requesterId must
    //          match auth uid, status must be "pending".
    // Read:    requester, anyone whose role is in visibleToRoles, or
    //          an admin / global approver.
    // Update:  TWO independent branches —
    //   (a) approve/reject: admin / global approver / anyone in
    //       visibleToRoles can flip status pending → approved|rejected.
    //   (b) chat metadata: anyone with parent-booking visibility can
    //       update ONLY {lastMessageAt, lastMessageAuthorId,
    //       lastReadByUser}. Enforced via diff().affectedKeys()
    //       .hasOnly(...). Used by sendBookingMessage (stamps latest-
    //       message metadata) and BookingChat (read-receipt).
    //
    //       Note: this branch doesn't constrain WHICH key of the
    //       lastReadByUser map gets written — a malicious user could
    //       suppress unread for another user by writing their uid.
    //       Acceptable for the institutional threat model; harden
    //       later if needed.
    // Delete:  admin only.
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {

      function canSeeBooking() {
        return resource.data.requesterId == request.auth.uid
          || myRole() in resource.data.visibleToRoles
          || isAdmin()
          || isGlobalApprover();
      }

      function isChatMetadataOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessageAt",
            "lastMessageAuthorId",
            "lastReadByUser"
          ]);
      }

      allow create: if isApproved()
        && !cannotBook()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if isApproved() && (
        resource.data.requesterId == request.auth.uid
        || myRole() in resource.data.visibleToRoles
        || isAdmin()
        || isGlobalApprover()
      );

      allow update: if isApproved() && (
        (
          (
            isAdmin()
            || isGlobalApprover()
            || myRole() in resource.data.visibleToRoles
          )
          && request.resource.data.status in ["approved", "rejected"]
          && resource.data.status == "pending"
        )
        || (
          canSeeBooking()
          && isChatMetadataOnlyUpdate()
        )
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // bookings/{bookingId}/messages/{messageId}
    //
    // Per-booking chat threads. Same visibility model as the parent
    // booking: requester, anyone whose role is in visibleToRoles, or
    // an admin / global approver.
    //
    // Read:    matches parent booking visibility.
    // Create:  matches parent visibility AND authorId == auth.uid AND
    //          text is a non-empty string ≤ 1000 chars. Kept in sync
    //          with MAX_MESSAGE_LENGTH in sendBookingMessage.js.
    // Update/
    // Delete:  denied — messages are immutable.
    //
    // The bookingDoc() helper does one extra get() per rule evaluation
    // (parent doc lookup); this is unavoidable for cross-doc auth and
    // is the same shape the parent rule uses on its own resource.data.
    // ---------------------------------------------------------------
    match /bookings/{bookingId}/messages/{messageId} {

      function bookingDoc() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      function canSeeParentBooking() {
        return bookingDoc().requesterId == request.auth.uid
          || myRole() in bookingDoc().visibleToRoles
          || isAdmin()
          || isGlobalApprover();
      }

      allow read: if isApproved() && canSeeParentBooking();

      allow create: if isApproved()
        && canSeeParentBooking()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update, delete: if false;
    }
  }
}
